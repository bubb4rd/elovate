NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site origin (required on Netlify so auth redirects stay on the primary host)
NEXT_PUBLIC_SITE_URL=https://elovatesr.netlify.app
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Community Discord post when poll-wz-cutoff inserts a new snapshot (optional).
# Unset -> Discord is skipped, ingest is unchanged. Set as a Supabase secret in prod; never commit a real URL.
# DISCORD_CUTOFF_WEBHOOK_URL=
# MIN_CUTOFF_DELTA=50

# Discord OAuth for Supabase Auth (local: also used by supabase/config.toml).
# Create an app at https://discord.com/developers/applications
# Redirect URL: {NEXT_PUBLIC_SUPABASE_URL}/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=

# SR screenshot OCR (optional — launch works without these)
# Enable Vision API on the GCP project. Prefer JSON string for Netlify.
# GOOGLE_CLOUD_CREDENTIALS=
# GOOGLE_APPLICATION_CREDENTIALS=
